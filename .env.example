# monochrome-api configuration
# All values are optional — sensible defaults are applied if unset (see src/config.ts).
# Copy to `.env` and adjust as needed.

# Runtime environment: development | production | test
# Controls log formatting (pretty in dev, JSON in production).
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Two-letter country code for Tidal catalog lookups.
TIDAL_COUNTRY=US

# The geeked aggregator API key (monochrome.tf ships this in its bundle).
# Override only if it rotates.
GEEKED_API_KEY=amp_29b2lIr4mze4tK-P8QDOxfMZ9anCgJ9_uGTUks3nIyo

# Public base URL used to build the /stream links inside /track manifests.
# Leave unset to derive it from the incoming request's host (fine for local use).
# Set this when running behind a proxy or on a public host, e.g. https://music.example.com
# PUBLIC_URL=https://music.example.com

# Launch Chromium with --no-sandbox (needed inside Docker; docker-compose sets this).
# CHROME_NO_SANDBOX=false

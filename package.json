{
  "name": "monochrome-api",
  "version": "1.0.0",
  "description": "hifi-api that yoinks music from monochrome.tf by mimicking a browser",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidofsky/monochrome-api"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "cloakbrowser": "^0.5.10",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "playwright": "^1.62.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "pino-pretty": "13.1.3",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
